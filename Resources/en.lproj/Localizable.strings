"settings.clock.preview_off" = "Off";

/* MARK: Settings window — about */

"settings.section.about" = "About";
"settings.about.body" = "ThemeSwitch changes the system appearance when the local time of the selected time zone reaches the two times above. The macOS system time zone does not affect it.";

