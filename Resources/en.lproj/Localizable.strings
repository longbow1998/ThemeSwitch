/*
   ThemeSwitch — English (the default language, see CFBundleDevelopmentRegion).
   Keys are semantic and must stay in sync with zh-Hans.lproj/Localizable.strings.
   Placeholders (%@, %d) must appear in the same order in both languages.
   Keep "HH" in every time format: the clock is 24-hour on purpose.
*/

/* MARK: Menu bar menu */

/* Current appearance + auto switch state, e.g. "Now: Dark Mode · Auto switching: Enabled" */
"menu.status.current" = "Now: %@ · Auto switching: %@";
"menu.autoswitch.enabled" = "Enabled";
"menu.autoswitch.disabled" = "Disabled";
/* Paused by a manual switch, e.g. "Now: Dark Mode · Auto switching paused (resumes at Tomorrow 07:00)" */
"menu.status.paused" = "Now: %@ · Auto switching paused (resumes at %@)";
"menu.override.notice" = "Paused temporarily after a manual switch. Scheduled switching resumes automatically at %@, no action needed.";
/* Auto switching is disabled / both times are equal — nothing is scheduled */
"menu.next.disabled" = "Auto switching is off, so nothing is switched on schedule";
"menu.next.same_time" = "Dark and light times are the same, so no switching happens";
/* e.g. "Next: Tomorrow Beijing 19:00 → Dark Mode" */
"menu.next.format" = "Next: %@%@ %@ → %@";
/* Target of the next switch (the last placeholder of menu.next.format) */
"menu.next.target.dark" = "Dark Mode";
"menu.next.target.light" = "Light Mode";
"menu.day.tomorrow" = "Tomorrow";
"menu.resume" = "Resume Auto Switching";
"menu.settings" = "Settings…";
"menu.quit" = "Quit ThemeSwitch";
"menu.quick.toDark" = "Switch to Dark Mode";
"menu.quick.toLight" = "Switch to Light Mode";

/* MARK: Appearance */

"appearance.dark" = "Dark Mode";
"appearance.light" = "Light Mode";
/* Menu bar fallback text, only used when the SF Symbol is unavailable */
"status.icon.dark" = "Dark";
"status.icon.light" = "Light";
/* Accessibility descriptions of the menu bar icon */
"a11y.auto_switch.paused" = "Auto switching paused";
"a11y.status.paused_format" = "%@ (auto switching paused)";

/* MARK: Date formats (24-hour) */

/* Menu bar clock: date, weekday, time */
"clock.date_format" = "MMM d EEE HH:mm";
/* Fallback date for a switch time that is neither today nor tomorrow */
"date.month_day_format" = "MMM d";

/* MARK: Settings window — general */

"settings.window.title" = "ThemeSwitch Settings";
"settings.section.general" = "General";
"settings.general.enable" = "Enable automatic switching";
"settings.general.launch_at_login" = "Launch at login";
"settings.general.launch_at_login_hint" = "Start ThemeSwitch automatically when you log in, so you do not have to open it by hand.";
"settings.general.footer" = "While automatic switching is off, the app no longer changes the system appearance and only keeps the menu bar icon and the manual switch items. Launch at login is written to the system only after you click Save.";
"settings.general.language" = "Interface language";
"settings.general.language_hint" = "Takes effect right away: the menu, the menu bar clock, alerts and this window all use the selected language. If something still shows the old one, reopen this window or restart the app.";

/* MARK: Interface language options */

/* "Follow System" follows the current interface language; the two language names are written in their own
   language and are identical in both .strings files, so they are never translated. */
"language.follow_system" = "Follow System";
"language.en" = "English";
"language.zh_hans" = "简体中文";

/* MARK: Settings window — time zone */

"settings.section.time_zone" = "Time Zone";
"settings.time_zone.label" = "Time zone";
"settings.time_zone.reference_label" = "Reference time zone";
"settings.time_zone.footer" = "The time zone decides when the switch happens. The reference time zone is only used to show those switch times as the local time of the city you care about. Both pickers accept a choice from the list or any IANA identifier you type, for example Asia/Tokyo.";

/* MARK: Settings window — switch times */

"settings.section.switch_times" = "Switch Times";
"settings.switch_times.to_dark" = "Switch to dark";
"settings.switch_times.to_light" = "Switch to light";
"settings.switch_times.footer" = "The times are judged in the time zone selected above. If both times are equal, the appearance stays light all day and never switches.";

