"settings.section.clock" = "Menu Bar Clock";
"settings.clock.show" = "Show clock";
"settings.clock.time_zone_label" = "Clock time zone";
"settings.clock.footer" = "When on, the date, weekday and time (24-hour) of the selected time zone are shown after the menu bar icon. This only affects the display and has nothing to do with automatic switching or how dark and light are decided.";
