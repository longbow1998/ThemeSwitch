/*
   ThemeSwitch — 简体中文。
   key 与 en.lproj/Localizable.strings 必须完全一致（语义化 key，不要用中文原文当 key）。
   占位符（%@、%d）在两种语言里必须保持同样的出现顺序。
   时间格式一律保留 "HH"：菜单栏时钟固定 24 小时制。
*/

/* MARK: 菜单栏菜单 */

/* 首行状态，例如「当前：深色模式 · 自动切换已启用」 */
"menu.status.current" = "当前：%@ · 自动切换已%@";
"menu.autoswitch.enabled" = "启用";
"menu.autoswitch.disabled" = "停用";
/* 手动覆盖期间的首行状态，例如「当前：深色模式 · 自动切换已暂停（至 明天 07:00 恢复）」 */
"menu.status.paused" = "当前：%@ · 自动切换已暂停（至 %@ 恢复）";
"menu.override.notice" = "手动切换后临时暂停，到 %@ 会自动恢复按计划切换，无需手动操作";
/* 自动切换停用 / 两个时间点相同：都没有「下次切换」可言 */
"menu.next.disabled" = "自动切换已停用，不会定时切换";
"menu.next.same_time" = "深浅色时间相同，不会自动切换";
/* 例如「下次：明天 北京 19:00 转为深色」 */
"menu.next.format" = "下次：%@%@ %@ 转为%@";
/* 下次切换的目标（menu.next.format 的最后一个占位符） */
"menu.next.target.dark" = "深色";
"menu.next.target.light" = "浅色";
"menu.day.tomorrow" = "明天";
"menu.resume" = "恢复自动切换";
"menu.settings" = "设置…";
"menu.quit" = "退出 ThemeSwitch";
"menu.quick.toDark" = "立即切换为深色";
"menu.quick.toLight" = "立即切换为浅色";

